DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agents_trading
REDIS_URL=redis://localhost:6379/0
AUTO_START_PIPELINE=true

# Set to "true" when agents run in a separate container (docker-compose microservice mode)
# Set to "false" (default) to run agents embedded inside the backend process
AGENTS_STANDALONE=false

# Binance Futures API
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# Binance base URLs — change if your region blocks binance.bh
BINANCE_SPOT_URL=https://www.binance.bh
BINANCE_FAPI_URL=https://www.binance.bh
BINANCE_FALLBACK_URL=https://data-api.binance.vision

# Trading settings
DEFAULT_LEVERAGE=5
MAX_LEVERAGE=20
POSITION_SIZE_PERCENT=2.0
MAX_OPEN_POSITIONS=3
